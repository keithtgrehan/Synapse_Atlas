      "checkConstraints": {
        "claims_source_version_requires_source": {
          "name": "claims_source_version_requires_source",
          "value": "\"claims\".\"source_version_id\" IS NULL OR \"claims\".\"source_id\" IS NOT NULL"
        },
        "claims_fact_source_required": {
          "name": "claims_fact_source_required",
          "value": "\"claims\".\"evidence_class\" NOT IN ('SOURCE_FACT', 'STRUCTURED_EXTRACTION') OR \"claims\".\"source_id\" IS NOT NULL OR COALESCE(length(btrim(\"claims\".\"external_id\")), 0) > 0"
        },
        "claims_derived_formula_required": {
          "name": "claims_derived_formula_required",
          "value": "\"claims\".\"evidence_class\" <> 'DERIVED_CALCULATION' OR COALESCE(length(btrim(\"claims\".\"formula_version\")), 0) > 0"
        },
        "claims_model_provenance_required": {
          "name": "claims_model_provenance_required",
          "value": "\"claims\".\"evidence_class\" <> 'MODEL_INFERENCE' OR (COALESCE(length(btrim(\"claims\".\"model_version\")), 0) > 0 AND COALESCE(length(btrim(\"claims\".\"prompt_version\")), 0) > 0 AND COALESCE(length(btrim(\"claims\".\"schema_version\")), 0) > 0 AND COALESCE(length(btrim(\"claims\".\"source_locator\")), 0) > 0 AND \"claims\".\"confidence\" IS NOT NULL)"
        },
        "claims_confidence_range": {
          "name": "claims_confidence_range",
          "value": "\"claims\".\"confidence\" IS NULL OR (\"claims\".\"confidence\" >= 0 AND \"claims\".\"confidence\" <= 1)"
        },
        "claims_unknown_value": {
          "name": "claims_unknown_value",
          "value": "(\"claims\".\"evidence_class\" = 'UNKNOWN' AND \"claims\".\"value_json\" IS NULL) OR (\"claims\".\"evidence_class\" <> 'UNKNOWN' AND \"claims\".\"value_json\" IS NOT NULL)"
        },
        "claims_source_fact_not_model": {
          "name": "claims_source_fact_not_model",
          "value": "\"claims\".\"evidence_class\" <> 'SOURCE_FACT' OR (\"claims\".\"model_version\" IS NULL AND \"claims\".\"prompt_version\" IS NULL AND \"claims\".\"schema_version\" IS NULL)"
        }
      },
      "isRLSEnabled": false
    },
